  "rules": [
    {
      "id": "quadcaps",
      "group": "si",
      "text": "If the boomer dies last, the next wave is {sm_3ht1s_percent_chance}% likely to be 3 hunters + 1 smoker, otherwise 4 hunters.",
      "when": {
        "plugin": "l4d_QuadCaps.smx"
      },
      "reviewed": false
    },
    {
      "id": "dp",
      "group": "hunter",
      "text": "Damage pounces (DPs): pounce damage grows with distance from {z_pounce_damage_range_min} units, up to {pounceuncap_maxdamage} damage at {z_pounce_damage_range_max} units or more.",
      "when": {
        "plugin": "pounce_maxdamage.smx"
      },
      "reviewed": false
    },
    {
      "id": "no_deadstops",
      "group": "hunter",
      "text": "Hunters cannot be deadstopped (shoved out of the air) mid-pounce, and cannot be shoved for {hunter_ground_m2_godframes} s after landing.",
      "when": {
        "plugin": "l4d_no_hunter_deadstops.smx"
      },
      "reviewed": false
    },
    {
      "id": "skypounce_1",
      "group": "hunter",
      "text": "Sky pounce limit: a hunter that starts a pounce at a flat, ceiling-skimming angle ({l4d_skypounce_pitch_min} to {l4d_skypounce_pitch_max} degrees down) cannot attack again in the air for {l4d_skypounce_cooldown} s, which stops chaining pounces off the map's sky.",
      "when": {
        "cvar": "l4d_skypounce_mode",
        "equals": "1"
      },
      "reviewed": false
    },
    {
      "id": "skypounce_2",
      "group": "hunter",
      "text": "Sky pounce limit: a hunter can pounce off the map's sky {l4d_skypounce_allow} time per flight.",
      "when": {
        "cvar": "l4d_skypounce_mode",
        "equals": "2"
      },
      "reviewed": false
    },
    {
      "id": "godframes",
      "group": "survivors",
      "text": "Godframes (survivors take no damage): {gfc_hunter_duration} s after a hunter's pounce ends, {gfc_smoker_duration} s after a smoker lets go, {gfc_revive_duration} s after a revive. After a smoker lets go, commons still cannot hurt for a further {gfc_common_extra_time} s and friendly fire for a further {gfc_ff_extra_time} s. Hittables and the witch always ignore godframes.",
      "when": {
        "plugin": "l4d_godframes_and_hittable_control.smx"
      },
      "reviewed": false
    },
    {
      "id": "tongue_timer",
      "group": "smoker",
