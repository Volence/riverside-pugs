{
  "name": "pug",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "DEV_MODE=1 REPLAY_DIR=\"${REPLAY_DIR:-$PWD/data/replays-test}\" concurrently -n api,web -c cyan,magenta \"tsx watch src/index.ts\" \"vite\"",
    "dev:api": "DEV_MODE=1 REPLAY_DIR=\"${REPLAY_DIR:-$PWD/data/replays-test}\" tsx watch src/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "prestart": "npm run build",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "shoot": "node scripts/shoot-pages.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^10.1.2",
    "@fastify/websocket": "^11.3.0",
    "basic-ftp": "^6.2.1",
    "better-sqlite3": "^13.0.2",
    "discord.js": "^14.27.0",
    "fastify": "^5.11.0",
    "openskill": "^5.0.1",
    "preact": "^10.29.8",
    "preact-iso": "^2.12.2"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.2",
    "concurrently": "^10.0.5",
    "happy-dom": "^20.14.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.10"
  }
}
